# Copy to .env for local development. Real values live in Vercel's
# project settings, never in the repo.

# The contact form emails each message through Resend (free tier).
# API key from resend.com > API Keys.
RESEND_API_KEY=
# The inbox that receives messages. Without a verified domain on Resend, this must be the
# address the Resend account was signed up with.
CONTACT_TO=
# Optional sender. Leave empty to use Resend's shared onboarding sender.
CONTACT_FROM=
